# Get a free key at https://console.groq.com (no credit card needed)
GROQ_API_KEY=

# Model for the support agent's replies (free tier)
GROQ_MODEL=openai/gpt-oss-20b

# --- Hindsight memory ---
# embedded = server runs inside this app (recommended, no Docker needed)
# cloud    = use Hindsight Cloud at https://ui.hindsight.vectorize.io (promo code MEMHACK99 = $50 credits)
# off      = disable memory (for testing the memory-less baseline)
HINDSIGHT_MODE=embedded

# Only used when HINDSIGHT_MODE=embedded: which LLM the memory server uses
HINDSIGHT_LLM_PROVIDER=groq
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b

# Only used when HINDSIGHT_MODE=cloud
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

PORT=5000
